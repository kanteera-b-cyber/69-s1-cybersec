services:
  db:
    image: postgres:16-alpine
    container_name: 69-s2-db
    ports:
      - "54321:5432"
    environment:
      - POSTGRES_PASSWORD=123456
      - POSTGRES_USER=kanteera
      - POSTGRES_DB=kanteera

  admin:
    image: dpage/pgadmin4:8.8
    container_name: 69-s2-admin
    ports:
      - "8082:80"
    environment:
      - PGADMIN_DEFAULT_EMAIL=kanteera-b@rmutp.ac.th
      - PGADMIN_DEFAULT_PASSWORD=123456
